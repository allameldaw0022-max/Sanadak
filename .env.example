# Copy to .env.local and fill in real values there. Never commit real
# secrets — this file only documents which variable names the app expects.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used exclusively by the trusted, server-side
# APK security-scan pipeline (src/lib/security/*) to write scan results
# that developers/users can never write themselves. Get it from
# Supabase Dashboard -> Project Settings -> API -> service_role key.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix, never import
# supabase/service.ts from a client component).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (APK storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# APK malware scanning (optional but recommended for production).
# Without these, every APK is routed to SECURITY_REVIEW instead of being
# auto-passed (fail-closed) — set them to enable automatic clean/malicious
# verdicts via VirusTotal hash lookups.
# MALWARE_SCAN_PROVIDER must currently be exactly "virustotal".
MALWARE_SCAN_PROVIDER=
MALWARE_SCAN_API_KEY=

# Device verification system (IMEI). Server-only secret used as the HMAC key
# for device_imeis.imei_hash (src/lib/devices/imei.ts) -- never the raw IMEI
# itself, which is what lets a device be referenced safely in less-tightly
# -scoped places (logs, audit events) without exposing the number. Generate
# with `openssl rand -hex 32`. Not yet read by any deployed route (backend
# schema only so far) but required once the registration Server Action lands.
IMEI_HASH_SECRET=
